[TEMPLATE]
# --- AI Response: two tiers, picked in the app by friendly label only ---
#   UI "Fast Response" -> GROQ_*    (lowest time-to-first-token)
#   UI "Overall Good"  -> GEMINI_*  (better coaching quality, still streaming)
# Provider and model names are never sent to the browser UI.
# Default tier when its key exists (fast | quality). The app default is fast.
LLM_DEFAULT_RESPONSE_MODE=fast

# --- Fast tier: Groq (OpenAI-compatible, SSE streaming) ---
GROQ_API_KEY=
# Comma-separated = tiny failover chain. openai/gpt-oss-20b = lowest TTFT;
# alternatives: openai/gpt-oss-120b, qwen/qwen3.8-27b, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# sent only to reasoning-capable models (gpt-oss/qwen); instant models reject it
GROQ_REASONING_EFFORT=low

# --- Quality tier: Gemini free tier (OpenAI-compatible) ---
GEMINI_API_KEY=
# Optional single-model override for the head of the chain below
GEMINI_MODEL=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PRIMARY=gemini-3.5-flash-lite
LLM_SECONDARY=gemini-3.1-flash-lite
LLM_FALLBACK=gemma-4-31b-it
LLM_THINKING_LEVEL=minimal
# Optional local fallback (100% free, offline). Set LLM_ALLOW_OLLAMA=true + run `ollama serve`.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
LLM_ALLOW_OLLAMA=false

# --- TTS: Fish Audio S2.1 Pro Free (voice picker in settings UI) ---
FISH_API_KEY=
# Server default voice (Flow). Others selectable in UI:
#   Flow:     802e3bc2b27e49c2995d23ef70e6ac89
#   Modi:     8b734220ba20480aa95b5e6329730003
#   Trump:    010da99c66f44d319159c8588315f22c
#   Osho:     06134e9a49cb4a36997b75402c8a0621
#   Pragyesh: 5c440edc2182445eaf7e2da219a24c03
#   Sarah:    933563129e564b19a115bedd57b7406a
#   Natasha:  e80db686476f4ccda758da35cacfb993
#   Hindi:    8988e6f626114e78bfc4482e0f46b4be  (Hindi-native voice — use this for Hindi)
FISH_VOICE_ID=802e3bc2b27e49c2995d23ef70e6ac89
# FISH_REFERENCE_ID works as an alias for FISH_VOICE_ID.
# Free-tier model. NOTE: it goes in the `model:` request HEADER, not the body.
# Keep s2.1-pro-free — it is the free tier and it streams.
FISH_MODEL=s2.1-pro-free
# Latency tuning (docs.fish.audio). balanced = lowest time-to-first-audio;
# chunk_length 100 starts audio sooner; 64kbps mp3 = fewer bytes to receive first.
# Fish answers chunked, so /api/tts/stream can start playback on the first frames
# (measured ~0.6-1.0s to first frames vs ~2.2-2.9s for the complete mp3).
FISH_LATENCY=balanced
FISH_CHUNK_LENGTH=100
FISH_MP3_BITRATE=64

# --- STT ---
# Default: browser Web Speech API (free, unlimited, no key). Server passthrough.
# Optional: deepgram (set key) or local whisper (not required).
STT_PROVIDER=browser
DEEPGRAM_API_KEY=

# --- App ---
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
DEFAULT_MODE=free
DEFAULT_CORRECTION=balanced
DEFAULT_LEVEL=auto
# Beat before the AI answers. It was 350ms of pure added latency; keep it small.
REPLY_PAUSE_MS=80
