# Exactly three response modes. Gemini Live Preview is the default.
LLM_DEFAULT_RESPONSE_MODE=gemini_live

# Gemini Live Preview and Gemini + Fish Audio
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_MODEL=
LLM_PRIMARY=gemini-3.5-flash-lite
LLM_SECONDARY=gemini-3.1-flash-lite
LLM_FALLBACK=gemma-4-31b-it
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_THINKING_LEVEL=minimal

# Groq + Fish Audio (also enables server Whisper transcription)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REASONING_EFFORT=low

# Required by BOTH Fish Audio modes. Never replaced with browser speech.
FISH_API_KEY=
FISH_VOICE_ID=802e3bc2b27e49c2995d23ef70e6ac89
FISH_LATENCY=balanced
FISH_CHUNK_LENGTH=100
FISH_MP3_BITRATE=64
# Fixed to the free Fish model in the request header; no paid model upgrade.
TTS_PROVIDER=fish

# Browser speech RECOGNITION is still an input fallback when no Groq key is set.
# Browser speech SYNTHESIS, local AI and Demo Coach are removed.
DATA_DIR=./data
DEFAULT_MODE=free
DEFAULT_CORRECTION=balanced
DEFAULT_LEVEL=auto
REPLY_PAUSE_MS=0
TURN_TIMEOUT_S=45
MAX_SESSIONS=200
SESSION_TTL_S=3600
ALLOWED_ORIGINS=
